# Nutrikit: production environment.
# Fill in every value marked <...>, then set them as secrets on your hosting platform
# (Render / Railway / Fly / VM). Do not commit the filled-in copy.
# Free setup on Render + Supabase: see render.yaml and docs/deployment.md.
# Generate secrets with: openssl rand -hex 32
#
# Deploy order:
#   1. Create a managed PostgreSQL 16+ database and set DATABASE_URL below.
#   2. Run migrations once, before the app takes traffic:  npm run migrate   (with this DATABASE_URL)
#   3. Build and run the image:  docker build -f docker/Dockerfile -t nutrikit .
#   4. Check https://<your-domain>/v1/health  ->  "status":"ok", "provider":"openai"

# ============================================================
# REQUIRED
# ============================================================

# Managed Postgres (not localhost). Keep sslmode=require for hosted databases.
# Supabase: Connect -> Session pooler (port 5432; not the direct connection or the port-6543 pooler).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Signs access tokens. The Docker image refuses to start without it.
# Generate once; keep it identical across deploys and on every instance.
NUTRIKIT_TOKEN_SECRET=<openssl rand -hex 32>

# Session cookies get the Secure flag. Keep 1 when serving over HTTPS.
NUTRIKIT_SECURE_COOKIES=1

# Proxies in front of the server, so rate limits see the real client address.
# Render: 1 (every request comes through its proxy). Elsewhere: the proxy hop count, or its addresses/CIDRs.
NUTRIKIT_TRUST_PROXY=1

# Bearer token for /admin and /v1/admin/*. Use a NEW value, not your local one.
NUTRIKIT_ADMIN_TOKEN=<openssl rand -hex 32>

# ============================================================
# AI: photo logging, label photos, log/text with ai: true
# ============================================================

OPENAI_API_KEY=<sk-...>
# NUTRIKIT_OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Or use Claude instead (it wins when both keys are set):
# ANTHROPIC_API_KEY=
# NUTRIKIT_AI_PROVIDER=openai
# Deadline for one AI call, retries included (then 504 ai_timeout, nothing charged).
# NUTRIKIT_AI_TIMEOUT_MS=60000

# ============================================================
# PAYMENTS (Razorpay)
# ============================================================

# rzp_test_... while testing the deployment, rzp_live_... for real payments.
RAZORPAY_KEY_ID=<rzp_live_...>
RAZORPAY_KEY_SECRET=<...>
# Dashboard -> Account & Settings -> Webhooks:
# URL https://<your-domain>/webhooks/razorpay, event order.paid; paste its secret here.
RAZORPAY_WEBHOOK_SECRET=<...>

# ============================================================
# EMAIL (verification and password reset)
# ============================================================

# Without these, production sends no emails: signups still work, but nobody can reset a password.
# Brevo (brevo.com, free, no domain needed): verify your sender address under Senders, then create an API key.
BREVO_API_KEY=<xkeysib-...>
NUTRIKIT_MAIL_FROM=<Nutrikit <you@gmail.com>>
# Or Resend, sending from a domain verified there (with both keys set, NUTRIKIT_MAIL_PROVIDER=resend picks it):
# RESEND_API_KEY=<re_...>
# Links in emails point at NUTRIKIT_PUBLIC_URL (set it to your site's address).

# ============================================================
# OPTIONAL (defaults shown)
# ============================================================

# Most hosts set PORT themselves.
# PORT=8787
# HOST=0.0.0.0
# Requests per minute per API key.
# NUTRIKIT_RATE_LIMIT=120
# Portal abuse limits per client address (needs NUTRIKIT_TRUST_PROXY behind a proxy):
# signups per hour, and failed logins per 15 minutes across all emails.
# NUTRIKIT_SIGNUP_LIMIT=5
# NUTRIKIT_LOGIN_IP_LIMIT=20
# Emails per hour: per address and kind (verify/reset), and per client address.
# NUTRIKIT_EMAIL_LIMIT=3
# NUTRIKIT_EMAIL_IP_LIMIT=10
# Postgres connections per instance (instances x pool must stay under the database's limit).
# NUTRIKIT_DB_POOL=10
# JSON request logs: fatal | error | warn | info | debug | silent
# NUTRIKIT_LOG_LEVEL=info
# 1 = serve barcodes from the cache only, no live Open Food Facts lookups.
# NUTRIKIT_OFFLINE=0
# NUTRIKIT_OFF_URL=https://world.openfoodfacts.org

# ============================================================
# DO NOT SET IN PRODUCTION
# ============================================================
# NUTRIKIT_AUTH=off         (turns off API key checks)
# TEST_DATABASE_URL         (test suite only)
# NODE_ENV                  (the Docker image already sets production)
# RAZORPAY_API_BASE         (test stubs only)
