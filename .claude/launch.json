{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8787,
      "env": {
        "NUTRIKIT_PUBLIC_URL": "http://localhost:5173",
        "NUTRIKIT_ALERT_WEBHOOK_URL": ""
      }
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 5173
    }
  ]
}
