# Copy to .env and adjust. Values below match compose.yml (local development only).
# Generate secrets with: openssl rand -hex 32

# --- Required (local dev) ---

# Application database (accounts, keys, usage, billing).
DATABASE_URL=postgres://nutrikit:nutrikit@localhost:5433/nutrikit

# Server used by the test suite: each run creates and drops its own nutrikit_test_<random>
# database on it, so this user needs CREATEDB.
TEST_DATABASE_URL=postgres://nutrikit:nutrikit@localhost:5433/postgres

# --- Server ---

PORT=8787
# HOST=0.0.0.0
# NUTRIKIT_WEB_DIST=web/dist

# production = refuse to start without NUTRIKIT_TOKEN_SECRET (the Docker image sets this).
# NODE_ENV=development

# --- Operator / admin API (/v1/admin/*) ---

# Bearer token for operator routes (list keys, upgrade requests, set plans).
# Leave unset to disable the admin HTTP API. CLI `npm run create-key` still works with DATABASE_URL.
NUTRIKIT_ADMIN_TOKEN=local-dev-admin-change-me

# --- API auth & metering ---

# HMAC secret for access tokens (nkat_…). If unset, one is generated once and stored in Postgres.
# Required in production (NODE_ENV=production).
# NUTRIKIT_TOKEN_SECRET=

# off = call the API without nk_ keys (local dev only).
# NUTRIKIT_AUTH=off

# NUTRIKIT_RATE_LIMIT=120
# Portal abuse limits per client address: signups per hour, failed logins per 15 minutes.
# NUTRIKIT_SIGNUP_LIMIT=5
# NUTRIKIT_LOGIN_IP_LIMIT=20
# NUTRIKIT_DB_POOL=10

# Proxies in front of the server: a hop count, or proxy addresses/CIDRs. Unset = trust none (local dev).
# NUTRIKIT_TRUST_PROXY=

# JSON request logs on stdout: fatal | error | warn | info | debug | silent
# NUTRIKIT_LOG_LEVEL=info

# --- Portal cookies ---

# 1 = Secure flag on session cookies (use behind HTTPS).
# NUTRIKIT_SECURE_COOKIES=1

# --- AI (optional) ---

# Set one of these to enable photo log, label photos and log/text with ai: true.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# anthropic | openai | none (default: anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY is set, else none)
# NUTRIKIT_AI_PROVIDER=anthropic
# NUTRIKIT_ANTHROPIC_MODEL=claude-opus-5-5
# NUTRIKIT_ANTHROPIC_EFFORT=medium
# NUTRIKIT_OPENAI_MODEL=gpt-5-mini
# Deadline for one AI call, retries included (then 504 ai_timeout, nothing charged).
# NUTRIKIT_AI_TIMEOUT_MS=60000
# Any OpenAI-compatible endpoint (Azure OpenAI, OpenRouter, Ollama at http://localhost:11434/v1, ...).
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Barcodes ---

# 1 = Open Food Facts cache only, no live lookups.
# NUTRIKIT_OFFLINE=0
# NUTRIKIT_OFF_URL=https://world.openfoodfacts.org

# --- Razorpay billing (optional): self-serve Starter and Growth, paid once per 30 days in INR ---
# Razorpay dashboard -> Test Mode -> Account & Settings -> API Keys -> Generate Test Key.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# Webhook backup for payments whose browser confirmation never arrived: Account & Settings -> Webhooks,
# URL https://<your domain>/webhooks/razorpay, event order.paid; paste its secret here.
# Not needed for local testing: payments are confirmed from the browser.
# RAZORPAY_WEBHOOK_SECRET=...
# Razorpay API origin; only change it to point at a stub server when testing.
# RAZORPAY_API_BASE=https://api.razorpay.com
# RAZORPAY_TIMEOUT_MS=15000

# --- Email (optional): verification and password-reset links ---
# Without these, emails are printed to the server console in development (follow the link from there).
# Brevo (brevo.com, free, no domain needed): verify your sender address under Senders, then create an API key.
# BREVO_API_KEY=xkeysib-...
# NUTRIKIT_MAIL_FROM="Nutrikit <you@gmail.com>"
# Or Resend (resend.com), sending from a domain you have verified there:
# RESEND_API_KEY=re_...
# NUTRIKIT_MAIL_FROM="Nutrikit <no-reply@yourdomain.com>"
# With both keys set, Brevo is used unless NUTRIKIT_MAIL_PROVIDER=resend.
# Links in emails use NUTRIKIT_PUBLIC_URL when set, else the request's host.
# Emails per hour: per address and kind (verify/reset), and per client address.
# NUTRIKIT_EMAIL_LIMIT=3
# NUTRIKIT_EMAIL_IP_LIMIT=10
# NUTRIKIT_MAIL_TIMEOUT_MS=15000

# --- MCP server (mcp/, `npm run dev -w mcp`) ---
# The MCP server is a client of this API: it needs an nk_ key from `npm run create-key -- "mcp"`.
# Claude Code / Claude Desktop pass these through their own MCP config instead (see mcp/README.md).
# NUTRIKIT_API_KEY=nk_...
# NUTRIKIT_BASE_URL=http://localhost:8787

# --- Browser tests (e2e/) ---
# Read from the shell, not this file: e.g. `E2E_BASE_URL=https://staging.example.com npm test -w e2e`.
# E2E_BASE_URL=http://localhost:8787
# NUTRIKIT_INSTANCES=http://127.0.0.1:8797,http://127.0.0.1:8798
