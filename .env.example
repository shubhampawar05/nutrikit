# Copy to .env and adjust. Values below match compose.yml (local development only).
# Generate secrets with: openssl rand -hex 32

# --- Required (local dev) ---

# Application database (accounts, keys, usage, billing).
DATABASE_URL=postgres://nutrikit:nutrikit@localhost:5433/nutrikit

# Server used by the test suite: each run creates and drops its own nutrikit_test_<random>
# database on it, so this user needs CREATEDB.
TEST_DATABASE_URL=postgres://nutrikit:nutrikit@localhost:5433/postgres

# --- Server ---

PORT=8787
# HOST=0.0.0.0
# NUTRIKIT_WEB_DIST=web/dist

# --- Operator / admin API (/v1/admin/*) ---

# Bearer token for operator routes (list keys, upgrade requests, set plans).
# Leave unset to disable the admin HTTP API. CLI `npm run create-key` still works with DATABASE_URL.
NUTRIKIT_ADMIN_TOKEN=local-dev-admin-change-me

# --- API auth & metering ---

# HMAC secret for access tokens (nkat_…). If unset, one is generated once and stored in Postgres.
# Required in production (NODE_ENV=production).
# NUTRIKIT_TOKEN_SECRET=

# off = call the API without nk_ keys (local dev only).
# NUTRIKIT_AUTH=off

# NUTRIKIT_RATE_LIMIT=120
# NUTRIKIT_DB_POOL=10

# --- Portal cookies ---

# 1 = Secure flag on session cookies (use behind HTTPS).
# NUTRIKIT_SECURE_COOKIES=1

# --- AI (optional) ---

# Enables Claude: photo log, label photos, log/text with ai: true.
# ANTHROPIC_API_KEY=

# anthropic | none (default: anthropic if ANTHROPIC_API_KEY is set, else none)
# NUTRIKIT_AI_PROVIDER=anthropic
# NUTRIKIT_ANTHROPIC_MODEL=claude-opus-5-5
# NUTRIKIT_ANTHROPIC_EFFORT=medium

# --- Barcodes ---

# 1 = Open Food Facts cache only, no live lookups.
# NUTRIKIT_OFFLINE=0
# NUTRIKIT_OFF_URL=https://world.openfoodfacts.org

# --- Razorpay billing (optional): self-serve Starter and Growth, paid once per 30 days in INR ---
# Razorpay dashboard -> Test Mode -> Account & Settings -> API Keys -> Generate Test Key.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# Webhook backup for payments whose browser confirmation never arrived: Account & Settings -> Webhooks,
# URL https://<your domain>/webhooks/razorpay, event order.paid; paste its secret here.
# Not needed for local testing: payments are confirmed from the browser.
# RAZORPAY_WEBHOOK_SECRET=...
