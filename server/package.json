{
  "name": "@nutrikit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nutrikit REST API server: food search, nutrient breakdowns, text/voice/photo meal logging, barcode and label scanning, meal plans.",
  "scripts": {
    "build:db": "node --import tsx scripts/build-db.mjs",
    "build:packaged": "node --import tsx scripts/build-packaged.mjs",
    "audit:data": "node --import tsx scripts/audit-catalog.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "migrate": "node --env-file-if-exists=../.env --import tsx src/cli/migrate.ts",
    "migrate:sqlite": "node --env-file-if-exists=../.env --import tsx scripts/migrate-sqlite-to-postgres.mjs",
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/main.ts",
    "build": "tsc -p .",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "create-key": "node --env-file-if-exists=../.env --import tsx src/cli/create-key.ts",
    "usage:reconcile": "node --env-file-if-exists=../.env --import tsx src/cli/reconcile-usage.ts",
    "openapi": "node --import tsx scripts/openapi.mjs",
    "test": "node --env-file-if-exists=../.env --import tsx --test 'test/*.test.mjs'",
    "typecheck": "tsc -p . --noEmit"
  },
  "engines": {
    "node": ">=22.16"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "typebox": "^1.4.3"
  }
}
